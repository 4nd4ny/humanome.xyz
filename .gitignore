# Dependencies
node_modules/
vendor/

# Builds
dist/
web/dist/
*.local

# Environments & secrets — never commit
.env
.env.*
!.env.example
!.env.deploy.example
.env.deploy
*.key
api-key*.txt
secrets/

# Golden Prompt — private by design (cahier §7)
assets-existants/golden-prompt/

# Twin9 — les GABARITS sont confidentiels (ADR-010) : jamais dans le dépôt.
# Le moteur, son oracle et ses vecteurs vivent dans le dépôt privé Twin_v9 ;
# restent ignorés, pour les clones qui les ont encore, une copie locale des
# gabarits et les oracles qu'y générait le moteur du navigateur (retiré par T11).
golden-twin9/
engine/test/twin9-oracles/
# La copie du moteur qu'embarque une release (<release>/Twin_v9, T18) : sous
# api/, EngineLoader la chargerait en développement ; aucun clone ne la porte.
Twin_v9/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Test artifacts
coverage/
playwright-report/
test-results/

# PHP
composer.phar
.phpunit.result.cache
web/public/data/
build/
backups/
web/.claude/

# Digest de doc de l'assistant tuteur : généré (build-tuteur-digest.mjs),
# régénéré à chaque stage-api — comme les prompt-packages, on ne versionne
# que le générateur, pas l'artefact (évite la dérive avec nav.js/content).
scripts/data/tuteur-digest.md

# Python (générateurs de vecteurs) — jamais versionner les caches compilés
# (ils embarquent le chemin absolu local de la machine qui les a produits).
__pycache__/
*.pyc

# Copie autonome de la cartographie : modèle généré par web/scripts/build-viewer.mjs
web/dist-viewer/
web/public/carto/viewer-template.html
# Démo anonymisée (« Préparer une démo ») : déposée par FTP, jamais versionnée (dépôt public).
web/public/data/demo/carto/
