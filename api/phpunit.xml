<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="api">
            <directory>tests</directory>
            <exclude>tests/UseCases</exclude>
        </testsuite>
        <!-- Use-case suites (docs/cas-utilisation/): unit = classes called
             directly, functional = the documented scenario played through
             the HTTP API. Both run with: composer test:usecases -->
        <testsuite name="usecases-unit">
            <directory>tests/UseCases/Unit</directory>
        </testsuite>
        <testsuite name="usecases-functional">
            <directory>tests/UseCases/Functional</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- PHPUnit retains every TestCase instance until the end of the
             run: at ~320 tests the suite already sat at 114 MB, right under
             the 128 MB container default — each new test class now tips it
             over. The use-case suites (~1 100 more tests) exhaust 512 MB when
             run together with or without the legacy suite, hence 2 GB.
             Test-runner-only setting; production php.ini is untouched. -->
        <ini name="memory_limit" value="2048M"/>
        <!-- No real key ever reaches a test (ADR-012): the providers' keys
             are emptied whatever the shell exports; a test that needs one
             sets a fake (TestDb::setEnv). -->
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="MISTRAL_API_KEY" value="" force="true"/>
        <env name="GOOGLE_API_KEY" value="" force="true"/>
        <env name="XAI_API_KEY" value="" force="true"/>
        <env name="OPENROUTER_API_KEY" value="" force="true"/>
    </php>
</phpunit>
