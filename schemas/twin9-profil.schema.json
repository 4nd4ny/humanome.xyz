{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanome.xyz/schemas/twin9-profil.schema.json",
  "title": "Profil d'un run Twin9",
  "description": "Décrit un run Twin9 de bout en bout (planning du moteur PHP, docs/plan-twin9-php.md de Twin_v9, lot 4a) : chaque paramètre d'algorithme du config.json de la v9.8, ses backends exceptés, et les options de sa ligne de commande qui règlent l'algorithme, troncatures comprises ; le collège des lecteurs ; pour chaque autre étape, le fournisseur, le modèle, le budget de sortie, l'effort et la réflexion, l'étage servant de valeur par défaut ; la voie, le parallélisme, le budget, la durée, la clé, le jeu de gabarits et le référentiel ; la stigmergie du greffier, un essai du moteur PHP, désactivée par défaut. Toute clé inconnue est refusée ; aucune température, que les modèles 5.5 refusent. Correspondance avec la v9.8 : docs/contrats.md §7.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "fournisseur": {
      "enum": [
        "anthropic",
        "openai",
        "mistral",
        "google",
        "xai",
        "openrouter"
      ],
      "description": "Fournisseur des appels (registre Twin9\\Fournisseurs\\Fournisseurs ; un test vérifie l'égalité), sans valeur par défaut : absent, c'est celui dont le réglage hérite — Anthropic pour un étage, son étage pour une étape, l'étage des lecteurs pour un lecteur. Un objet qui pose un autre fournisseur que celui dont il hérite pose aussi son modèle. Un run n'atteint que les fournisseurs que l'administrateur a ouverts (ADR-012)."
    },
    "modele": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]{0,79}$",
      "description": "Identifiant du modèle chez son fournisseur, 80 caractères au plus, par exemple « claude-haiku-5-5 » chez Anthropic. L'API vérifie qu'il suit le motif de ce fournisseur : « claude-… » chez Anthropic et nulle part ailleurs ; ni « / » ni « : » chez Google ; « éditeur/modèle », sans suffixe « : », chez OpenRouter."
    },
    "budget_sortie": {
      "type": "integer",
      "minimum": 1,
      "description": "Budget de sortie de l'appel : max_tokens chez Anthropic, réflexion comprise ; chez un autre fournisseur, son plafond de sortie, qui compte ou non le raisonnement selon le fournisseur (ADR-012)."
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "description": "Effort d'un appel Anthropic (output_config.effort). Absent : celui du modèle. Les autres fournisseurs n'en reçoivent pas : un appel qui part ailleurs que chez Anthropic n'en a aucun, pas même hérité de son étage."
    },
    "reflexion": {
      "enum": [
        "coupee",
        "adaptative"
      ],
      "description": "Réflexion d'un appel Anthropic : « coupee » sous la forme que le modèle accepte (disabled pour Haiku 5.5, between_tools pour Sonnet 5.5), ou « adaptative ». Chez un autre fournisseur, aucun paramètre d'Anthropic ne part : son raisonnement suit l'entrée de la grille de l'instance pour ce modèle (ADR-012)."
    },
    "reglage_etage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Réglage d'un étage, valeur par défaut de ses étapes ; son fournisseur, absent, est Anthropic.",
      "required": [
        "modele",
        "budget_sortie",
        "reflexion"
      ],
      "properties": {
        "fournisseur": {
          "$ref": "#/$defs/fournisseur"
        },
        "modele": {
          "$ref": "#/$defs/modele"
        },
        "budget_sortie": {
          "$ref": "#/$defs/budget_sortie"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "reflexion": {
          "$ref": "#/$defs/reflexion"
        }
      }
    },
    "reglage_etape": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ce qu'une étape change au réglage de son étage ; le reste vient de l'étage.",
      "required": [],
      "properties": {
        "fournisseur": {
          "$ref": "#/$defs/fournisseur"
        },
        "modele": {
          "$ref": "#/$defs/modele"
        },
        "budget_sortie": {
          "$ref": "#/$defs/budget_sortie"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "reflexion": {
          "$ref": "#/$defs/reflexion"
        }
      }
    },
    "lecteur": {
      "type": "object",
      "additionalProperties": false,
      "description": "Un lecteur du collège.",
      "required": [
        "nom"
      ],
      "properties": {
        "nom": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Nom du lecteur, unique dans le collège ; ses passes se nomment nom#1, nom#2…"
        },
        "famille": {
          "type": "string",
          "minLength": 1,
          "description": "Famille déclarée : deux lecteurs d'une même famille ne comptent que pour une dans l'exigence de diversité. Absente : son fournisseur, ou chez OpenRouter l'éditeur du modèle (le préfixe de son identifiant)."
        },
        "fournisseur": {
          "$ref": "#/$defs/fournisseur",
          "description": "Absent : celui de l'étage des lecteurs ; un autre que celui-là pose aussi le modèle du lecteur."
        },
        "modele": {
          "$ref": "#/$defs/modele",
          "description": "Absent : celui de l'étage des lecteurs."
        },
        "poids": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0,
          "description": "Pondération dans la carte de chaleur (weight)."
        },
        "passes": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Lectures décorrélées du même modèle (passes, ou --models nom:N)."
        },
        "budget_sortie": {
          "$ref": "#/$defs/budget_sortie"
        },
        "effort": {
          "$ref": "#/$defs/effort"
        },
        "reflexion": {
          "$ref": "#/$defs/reflexion"
        }
      }
    },
    "troncature": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "mode",
    "college",
    "etages",
    "etapes",
    "voie",
    "parallelisme",
    "budget_usd",
    "duree_minutes",
    "cle",
    "gabarits",
    "referentiel",
    "jours",
    "rescan",
    "memoire",
    "seuils_consensus",
    "juge_leger",
    "jury",
    "premiere_impression",
    "calques",
    "merge",
    "scan_global",
    "troncatures"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "description": "Version du schéma du profil."
    },
    "kind": {
      "const": "twin9-profil",
      "description": "Discriminant de type de document."
    },
    "mode": {
      "enum": [
        "test",
        "complet"
      ],
      "default": "complet",
      "description": "« test » : le run ne lit que la première journée du portfolio et le premier pôle du référentiel, pour les essais sur l'API."
    },
    "college": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lecteur"
      },
      "description": "Le collège des lecteurs (roster de la v9.8, --models). Noms uniques."
    },
    "etages": {
      "type": "object",
      "additionalProperties": false,
      "description": "Les trois étages de modèles de la v9.8.",
      "required": [
        "lecteurs",
        "rapide",
        "profond"
      ],
      "properties": {
        "lecteurs": {
          "$ref": "#/$defs/reglage_etage",
          "description": "Les lecteurs (taggers)."
        },
        "rapide": {
          "$ref": "#/$defs/reglage_etage",
          "description": "L'analyse rapide (backend_rapide, --modele-rapide)."
        },
        "profond": {
          "$ref": "#/$defs/reglage_etage",
          "description": "L'analyse profonde (backend_tribunal, --modele-tribunal)."
        }
      }
    },
    "etapes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Réglages propres à une étape ; sans réglage, elle suit son étage.",
      "required": [],
      "properties": {
        "premiere_impression": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Première impression (le Lecteur) (étage rapide)."
        },
        "greffier": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Greffier (étage rapide)."
        },
        "juge_leger": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Juge léger, chacune de ses passes (étage rapide)."
        },
        "contre_lecture": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Contre-lecture (étage rapide)."
        },
        "accusation": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Accusation (étage profond)."
        },
        "defense": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Défense (étage profond)."
        },
        "replique": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Réplique (étage profond)."
        },
        "briefing": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Briefing (étage profond)."
        },
        "jures": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Jurés, premier tour (étage profond)."
        },
        "relance": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Relance (étage profond)."
        },
        "second_tour": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Jurés, second tour (étage profond)."
        },
        "gardien_support": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Gardien du support (étage rapide)."
        },
        "gardien_raisonnement": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Gardien du raisonnement (étage profond)."
        },
        "president": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Président (étage profond)."
        },
        "second_ressort": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Second ressort : tous les appels du procès d'un faisceau (étage profond)."
        },
        "relectures": {
          "$ref": "#/$defs/reglage_etape",
          "description": "Relectures de la fusion : kairos, pôles, compétences, rapporteur (étage profond)."
        },
        "arpenteur": {
          "$ref": "#/$defs/reglage_etape",
          "description": "L'Arpenteur : condensés, lecture globale, retours aux sources (étage profond)."
        }
      }
    },
    "voie": {
      "enum": [
        "directe",
        "lots"
      ],
      "default": "lots",
      "description": "Voie des appels Anthropic : directs, ou par l'API Message Batches d'Anthropic, à moitié prix. Les appels aux autres fournisseurs partent toujours en direct."
    },
    "parallelisme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appels_directs",
        "journees"
      ],
      "properties": {
        "appels_directs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 6,
          "description": "Appels directs simultanés (remplace max_workers et parallel_jures), 32 au plus."
        },
        "journees": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Journées menées de front quand aucun appel ne part par lots ; dès qu'un appel part par lots (Anthropic, voie « lots »), toutes le sont."
        }
      }
    },
    "budget_usd": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "default": null,
      "description": "Plafond de coût du run en dollars ; null : aucun."
    },
    "duree_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "default": null,
      "description": "Plafond de durée du run en minutes ; null : aucun."
    },
    "cle": {
      "enum": [
        "instance",
        "personnelle"
      ],
      "default": "instance",
      "description": "La clé de l'instance, pour chaque fournisseur du profil. « personnelle » (la clé de l'utilisateur, chez Anthropic seulement) reste lisible, pour les profils et les runs gardés, mais ne sert plus : refusée à l'enregistrement, au lancement et à la reprise depuis l'ADR-013 (un run du serveur ne peut pas garder la clé du navigateur)."
    },
    "gabarits": {
      "type": "string",
      "minLength": 1,
      "default": "v9.8",
      "description": "Le jeu de gabarits : celui de la v9.8, le jeu par défaut de l'instance, ou une copie d'un promptologue de l'atelier."
    },
    "referentiel": {
      "type": "object",
      "additionalProperties": false,
      "description": "Le référentiel du run.",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "default": "respire",
          "description": "Identifiant du référentiel (referentiel_versions.referentiel_id)."
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "default": null,
          "description": "Version publiée (semver) ; null : la dernière, figée dans la copie du profil au lancement."
        }
      }
    },
    "jours": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "default": null,
      "description": "--jours : les N premières journées ; null : toutes."
    },
    "rescan": {
      "type": "boolean",
      "default": false,
      "description": "--rescan : de nouveaux calques même sur les journées inchangées."
    },
    "memoire": {
      "type": "boolean",
      "default": true,
      "description": "La carte se souvient : état persistant entre les runs (--sans-etat le coupe)."
    },
    "seuils_consensus": {
      "type": "object",
      "additionalProperties": false,
      "description": "Seuils du consensus journalier [CALIBRATION].",
      "required": [
        "conf_min",
        "corrobore",
        "instruire",
        "instruire_min_modeles",
        "suspicion_min"
      ],
      "properties": {
        "conf_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.4
        },
        "corrobore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        },
        "instruire": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "instruire_min_modeles": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "suspicion_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15
        }
      }
    },
    "juge_leger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passes",
        "contre_lecture"
      ],
      "properties": {
        "passes": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "--leger-passes"
        },
        "contre_lecture": {
          "type": "boolean",
          "default": true,
          "description": "--sans-contre-lecture la coupe."
        }
      }
    },
    "jury": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "taille_aleatoire",
        "graine",
        "archiviste_si_produite",
        "portraitiste_au_second_ressort",
        "specialistes",
        "par_competence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "socle4+1",
            "socle2+2",
            "aleatoire"
          ],
          "default": "socle4+1",
          "description": "--jury"
        },
        "taille_aleatoire": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6,
          "default": 5,
          "description": "--jury-taille"
        },
        "graine": {
          "type": "integer",
          "default": 1
        },
        "archiviste_si_produite": {
          "type": "boolean",
          "default": true
        },
        "portraitiste_au_second_ressort": {
          "type": "boolean",
          "default": true
        },
        "specialistes": {
          "type": "object",
          "default": {},
          "propertyNames": {
            "pattern": "^[1-9][0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Spécialiste imposé par numéro de pôle."
        },
        "par_competence": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Spécialiste imposé par code de compétence."
        }
      }
    },
    "premiere_impression": {
      "type": "boolean",
      "default": true
    },
    "calques": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accumulation",
        "max_archives"
      ],
      "properties": {
        "accumulation": {
          "type": "boolean",
          "default": true
        },
        "max_archives": {
          "type": "integer",
          "minimum": 0,
          "default": 12
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relectures",
        "max_histoires",
        "second_ressort",
        "seuil_faisceau_journees",
        "rapporteur"
      ],
      "properties": {
        "relectures": {
          "type": "boolean",
          "default": true,
          "description": "--sans-relectures les coupe."
        },
        "max_histoires": {
          "type": "integer",
          "minimum": 0,
          "default": 12
        },
        "second_ressort": {
          "type": "boolean",
          "default": true
        },
        "seuil_faisceau_journees": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "rapporteur": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "scan_global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "retour_max_caracteres"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "--scan-global"
        },
        "retour_max_caracteres": {
          "type": "integer",
          "minimum": 1,
          "default": 30000,
          "description": "Taille d'un lot du retour aux sources, pas un plafond."
        }
      }
    },
    "stigmergie": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "enabled": false
      },
      "description": "La stigmergie du greffier (sprint 3, de type ACO ; docs/twin9/spec-stigmergie.md de Twin_v9) : les passages que valident le juge léger ou le tribunal déposent une trace dans la mémoire de la carte, qui s'évapore d'une analyse de la journée à l'autre ; seul le greffier la lit, dans le bloc des calques de son dossier. Un essai, sans équivalent dans la v9.8 : désactivée par défaut, le moteur est celui de la v9.8. Aucun appel en plus. Activée, elle demande calques.accumulation à false (les calques archivés votent déjà au consensus : les traces y compteraient deux fois) ; le renforcement d'une analyse à l'autre demande rescan. L'activer, ou changer ses réglages, fait relire les journées de la carte. Une clé de premier niveau, jamais dans calques.",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Seul le booléen vrai l'active."
        },
        "evaporation": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1,
          "description": "ρ, ce que perd une trace à chaque analyse de la journée. Absent : 0,3, la valeur du moteur. Pas moins de 0,2 : en dessous, une trace peut disparaître d'un coup quand son analyse sort des 16 que lit un run."
        },
        "exploration": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "ε, la part des dossiers que monte un greffier explorateur, aveugle aux traces, par un tirage déterministe. Absent : 0,2, la valeur du moteur."
        },
        "graine": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "La graine des tirages des explorateurs. Absent : 1, la valeur du moteur. Entre -(2^53 - 1) et 2^53 - 1 : au-delà, un entier se lit en flottant (JSON, PHP), que le moteur refuse."
        },
        "lignes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "K, le nombre de lignes de traces, au plus, dans le dossier d'une compétence. Absent : 5, la valeur du moteur."
        }
      }
    },
    "troncatures": {
      "type": "object",
      "additionalProperties": false,
      "description": "Les troncatures de la v9.8, à leurs valeurs d'origine.",
      "required": [
        "journee",
        "tribunal",
        "fusion",
        "rapport",
        "arpenteur"
      ],
      "properties": {
        "journee": {
          "type": "object",
          "additionalProperties": false,
          "description": "La journée : lecteurs, ancrage, greffier, juge léger, suspicions.",
          "required": [
            "justification_tag",
            "alerte_lecteur",
            "rejet_extrait",
            "span_caracteres",
            "calques_extrait",
            "calques_lignes",
            "trace_extrait",
            "traces_par_verdict",
            "ecarte_extrait",
            "ecartes_par_verdict",
            "suspicion_extrait",
            "suspicions_minoritaires",
            "suspicions_sous_seuil"
          ],
          "properties": {
            "justification_tag": {
              "$ref": "#/$defs/troncature",
              "default": 400,
              "description": "Justification d'un tag de lecteur."
            },
            "alerte_lecteur": {
              "$ref": "#/$defs/troncature",
              "default": 300,
              "description": "Alerte d'instructions embarquées, signalée par un lecteur."
            },
            "rejet_extrait": {
